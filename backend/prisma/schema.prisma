generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum MemoryPrivacy {
  PRIVATE
  SHARED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  ANNIVERSARY
  SYSTEM
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique @db.VarChar(191)
  passwordHash           String                   @db.VarChar(255)
  displayName            String                   @db.VarChar(100)
  avatarUrl              String?                  @db.VarChar(2048)
  timezone               String                   @default("UTC") @db.VarChar(64)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  refreshTokens          RefreshToken[]
  memories               Memory[]
  favorites              Favorite[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  devicePushTokens       DevicePushToken[]
  chatConversations      ChatConversation[]
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model Memory {
  id           String        @id @default(cuid())
  title        String        @db.VarChar(200)
  description  String?       @db.Text
  memoryDate   DateTime
  locationName String?       @db.VarChar(255)
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  privacy      MemoryPrivacy @default(PRIVATE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  media        MemoryMedia[]
  favorites    Favorite[]
  @@index([userId, memoryDate])
  @@index([userId, locationName])
  @@index([latitude, longitude])
  @@map("memories")
}

model MemoryMedia {
  id           String    @id @default(cuid())
  type         MediaType
  url          String    @db.VarChar(2048)
  publicId     String    @unique @db.VarChar(255)
  thumbnailUrl String?   @db.VarChar(2048)
  width        Int?
  height       Int?
  durationSec  Int?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  memoryId     String
  memory       Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  @@index([memoryId, sortOrder])
  @@map("memory_media")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  memoryId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  @@unique([userId, memoryId])
  @@index([memoryId])
  @@map("favorites")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  anniversaryEnabled Boolean  @default(true)
  emailEnabled       Boolean  @default(false)
  pushEnabled        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("notification_preferences")
}

model DevicePushToken {
  id        String   @id @default(cuid())
  token     String   @unique @db.VarChar(512)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("device_push_tokens")
}

model ChatConversation {
  id        String        @id @default(cuid())
  title     String?       @db.VarChar(200)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  role           ChatMessageRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}
